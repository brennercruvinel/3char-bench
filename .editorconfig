# formatacao base, agnostica de stack. ver https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# markdown usa dois espacos no fim de linha como quebra dura
[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{json,yaml,yml,toml}]
indent_size = 2

[*.{sh,lua}]
indent_size = 2

[Makefile]
indent_style = tab
